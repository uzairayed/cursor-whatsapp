# Owner WhatsApp number(s). Digits only, country code, no +.
# Comma-separated if more than one.
# REQUIRED. The bridge will not start if this is empty.
ALLOWED_NUMBERS=15551234567

# Alternate name for a single owner number:
# ADMIN_WHATSAPP_PHONE=15551234567

# Optional: casual numbers that can only chat in the built-in general/ workspace.
# Comma-separated, digits only, no +. If a number is in both lists, owner wins.
# CASUAL_NUMBERS=15559876543,15557654321

# Optional: name shown in WhatsApp Linked Devices
APP_NAME=CursorWA

# Optional: force Cursor CLI binary path (defaults to `cursor` on PATH)
# CURSOR_BIN=cursor

# Optional: default project key from projects.json
# DEFAULT_PROJECT=webapp

# Optional: kill a Cursor run after N minutes (default 15)
# CURSOR_TIMEOUT_MIN=15

# Optional: OpenAI API key for voice-note transcription (Whisper)
# OPENAI_API_KEY=sk-...

# Optional: delete inbox media + logs older than N days on startup (default 7)
# RETENTION_DAYS=7
